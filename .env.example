# ==============================================================================
# AI Voice-Assisted Banking Kiosk - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Ports & Host Endpoints
# ------------------------------------------------------------------------------
BANKING_API_PORT=8000
SECURITY_SVC_PORT=8001
VOICE_AI_PORT=8002
FACE_AUTH_PORT=8003
CUSTOMER_KIOSK_PORT=5173
TELLER_PORTAL_PORT=5174
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Microservice URLs
# ------------------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
SECURITY_SERVICE_URL=http://127.0.0.1:8001
VOICE_AI_URL=http://127.0.0.1:8002
FACE_AUTH_URL=http://127.0.0.1:8003
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# Biometric & Identity Verification Settings
# ------------------------------------------------------------------------------
FACE_MATCH_THRESHOLD=0.60
LIVENESS_MIN_FRAMES=12
LIVENESS_WINDOW_SECONDS=2.5
LIVENESS_EAR_CLOSED=0.18
LIVENESS_EAR_OPEN=0.22
ANTISPOOF_MIN_REAL_SCORE=0.50

# ------------------------------------------------------------------------------
# Security & Token Settings
# ------------------------------------------------------------------------------
TOKEN_TTL_SECONDS=1800
# SECURITY_SVC_KEY_B64=base64_encoded_32_byte_key_here
