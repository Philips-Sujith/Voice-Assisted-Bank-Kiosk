# ==============================================================================
# AI-Based Voice-Assisted Banking Kiosk - Environment Configuration Template
# ==============================================================================
# Rename or copy this file to .env for custom configuration.
# All defaults are pre-configured for standard local execution.

# Central Backend (Module 3)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Security QR Service (Module 5)
SECURITY_SVC_PORT=8001
SECURITY_SERVICE_URL=http://localhost:8001
TOKEN_EXPIRY_MINUTES=10

# Voice AI Service (Module 2)
VOICE_AI_HOST=127.0.0.1
VOICE_AI_PORT=8002
VOICE_AI_URL=http://localhost:8002

# Face Authentication & Biometrics Service (Module 4)
FACE_AUTH_HOST=127.0.0.1
FACE_AUTH_PORT=8003
FACE_AUTH_URL=http://localhost:8003

# Customer Kiosk Frontend (Module 1)
KIOSK_HOST=localhost
KIOSK_PORT=5173
KIOSK_URL=http://localhost:5173

# Staff Portal Frontend (Module 6)
STAFF_PORTAL_HOST=localhost
STAFF_PORTAL_PORT=5174
STAFF_PORTAL_URL=http://localhost:5174

# Redis In-Memory Protocol Broker
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_CHANNEL=kiosk:queue:events

# Biometrics & Liveness Configuration
CONFIDENCE_THRESHOLD=0.7
MAX_AUTH_RETRIES=2
